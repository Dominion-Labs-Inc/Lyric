# The world image rebuilds the Linux environment from requirements — it must NOT
# carry the macOS venv, caches, logs, VCS, or large local data into the build.
venv_lyric/
pyenv/
**/__pycache__/
*.pyc
.git/
logs/
*.log
experiments/**/sandbox*/
experiments/world/sandbox/
core/security/_disabled/
data/classifiers/
data/*.json
*.pt
*.pdf
.DS_Store
