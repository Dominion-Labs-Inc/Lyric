#!/bin/bash
#
# Lyric Start Script
# Starts the Lyric resident with the environment it runs under
#

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Directories
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
RUNTIME_DIR="$SCRIPT_DIR/runtime"
LOGS_DIR="$SCRIPT_DIR/logs"
MAIN_PID_FILE="$RUNTIME_DIR/lyric_main.pid"
LOG_FILE="$LOGS_DIR/lyric_main_$(date +%Y-%m-%d).log"

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN} Starting Lyric${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Refuse to start a second one: the resident is a singleton, and two of them would
# learn and keep against the same store.
RUNNING=$(pgrep -f "[Pp]ython3? -m core\.main" || true)
if [ -n "$RUNNING" ]; then
    echo -e "${RED}❌ Lyric is already running (PID: $RUNNING)${NC}"
    echo -e "${YELLOW}   Run ./lyric-stop first${NC}"
    echo ""
    exit 1
fi

mkdir -p "$RUNTIME_DIR" "$LOGS_DIR"

# WHERE THIS BOOT'S OWN LINES START. The day's log is appended to, so reading the whole file for the line that
# says reading is up finds the LAST boot's: started a second time on 2026-11-05, this reported
# "✓ Ready to read ..." from a boot twenty minutes earlier and returned at once, twenty-five seconds into a
# four-minute start, calling a resident ready that had not finished loading.
# The log is touched first: with no file there, the shell reports the failed redirection itself, which `2>/dev/null`
# on `wc` does not cover, so the first start of each day printed "No such file or directory" before anything else.
touch "$LOG_FILE"
FROM=$(( $(wc -l < "$LOG_FILE") + 1 ))

echo -e "${YELLOW}Launching the resident...${NC}"
echo -e "${BLUE}  log: $LOG_FILE${NC}"
echo ""

# THE TWO LINES THAT ARE EASY TO MISS IN A BOOT'S OWN OUTPUT, said again as banners as it scrolls past.
#
# Reading coming up: a grammar edit, or any word record written, makes the first read learn from every taught
# sentence again, so a start is minutes rather than seconds and the line that says it is done is thousands of
# lines in. A HALT: one the constitution wrote outlives the process that wrote it, and a resident that restored
# one refuses everything it is asked -- on 2026-11-17 that was worked against for half an hour because the
# warning was a single line among thousands.
#
# Started BEFORE the resident, because `exec` below leaves no shell to start it, and it watches `$$`, which is
# the resident's own pid once that exec has happened. It reads the log from where THIS boot's lines begin
# (`FROM`), so it cannot report the last boot's readiness: started a second time on 2026-11-05, that mistake
# called a resident ready twenty-five seconds into a four-minute start. It stops once reading is up, since a
# restored halt is written at the constitution's own start, long before the reader is warm.
RESIDENT=$$
(
    for i in $(seq 1 180); do
        ps -p "$RESIDENT" > /dev/null 2>&1 || exit 0
        if tail -n +"$FROM" "$LOG_FILE" 2>/dev/null | grep -qiE "emergency halt|HALTED"; then
            echo ""
            echo -e "${RED}⚠️  A constitution halt is in force; the resident will refuse requests${NC}"
            tail -n +"$FROM" "$LOG_FILE" | grep -hiE "emergency halt|HALTED" | tail -3
            echo ""
        fi
        if tail -n +"$FROM" "$LOG_FILE" 2>/dev/null | grep -q "Ready to read:"; then
            echo ""
            echo -e "${GREEN}✓ $(tail -n +"$FROM" "$LOG_FILE" | grep -h "Ready to read:" | tail -1 \
                | sed 's/.*INFO - //')${NC}"
            echo -e "${GREEN}  Lyric is up on PID $RESIDENT. Ctrl-C stops it.${NC}"
            echo ""
            exit 0
        fi
        sleep 5
    done
    echo ""
    echo -e "${YELLOW}⚠  Still warming after 15 minutes; it is up on PID $RESIDENT${NC}"
) &

# THE RESIDENT RUNS HERE, IN THIS TERMINAL, AS THIS PROCESS. It was started under `nohup` with every line going
# to the day's log and nothing to the screen, so starting Lyric showed four lines and a pid: the boot being
# waited through -- the store opening, the reader warming, every system coming up, and any fault among them --
# was visible only to someone who thought to `tail -f` the log afterwards.
#
# `exec`, NOT A BACKGROUND JOB WAITED FOR. `exec` replaces this shell with the resident, which keeps the pid, so
# `$$` is what runtime/lyric_main.pid holds and `lyric-stop`, `lyric-status` and `lyric-kill` all still find it;
# and Ctrl-C reaches the resident itself, which handles SIGINT and SIGTERM by shutting down (`core/main.py`
# installs both). The obvious alternative -- start it with `&`, `trap` INT, `wait` -- DOES NOT WORK on this
# machine: /bin/bash is 3.2.57, where `wait` is not interrupted by a trapped signal, so Ctrl-C was swallowed and
# left a resident running with no terminal (measured: the trap never fired and both processes stayed up).
#
# `tee` keeps the day's log exactly as it was, so nothing that used to be recorded has stopped being recorded.
# It IGNORES SIGINT (a disposition that survives its own exec), because it shares this process group: killed by
# the same Ctrl-C, it would close the pipe under a resident that was still writing its shutdown, and the record
# of the shutdown is the part worth keeping.
#
# `-u` because python block-buffers a pipe: without it the screen would fill in 8 KB jumps minutes apart.
# `< /dev/null` because nothing in core.main reads stdin, and a process that did would be stopped with SIGTTIN
# the moment it tried.
#
# The pid file is NOT removed when the resident exits -- there is no shell left to remove it. That is what
# happened before as well: `lyric-stop` and `lyric-kill` remove it, and both this script and `./lyric` check
# whether the pid in it is alive before believing it.
echo "$$" > "$MAIN_PID_FILE"
echo -e "${GREEN}✓ Starting as PID $$ (Ctrl-C stops it)${NC}"
echo ""

cd "$SCRIPT_DIR"
export POSTGRES_PORT=5433
export POSTGRES_USER=stefan
export POSTGRES_DATABASE=lyric_db
export LYRIC_NO_WATCHDOG=1
export TQDM_DISABLE=1
export LYRIC_TEACHING=1
export LYRIC_MICROPHONE=off
export LYRIC_CAMERA=off
exec ./venv_lyric/bin/python3 -u -m core.main < /dev/null \
    > >(trap '' INT; exec tee -a "$LOG_FILE") 2>&1
