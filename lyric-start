#!/bin/bash
#
# Lyric Start Script
# Starts the Lyric resident with the environment it runs under
#

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Directories
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
RUNTIME_DIR="$SCRIPT_DIR/runtime"
LOGS_DIR="$SCRIPT_DIR/logs"
MAIN_PID_FILE="$RUNTIME_DIR/lyric_main.pid"
LOG_FILE="$LOGS_DIR/lyric_main_$(date +%Y-%m-%d).log"

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN} Starting Lyric${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Refuse to start a second one: the resident is a singleton, and two of them would
# learn and keep against the same store.
RUNNING=$(pgrep -f "[Pp]ython3? -m core\.main" || true)
if [ -n "$RUNNING" ]; then
    echo -e "${RED}❌ Lyric is already running (PID: $RUNNING)${NC}"
    echo -e "${YELLOW}   Run ./lyric-stop first${NC}"
    echo ""
    exit 1
fi

mkdir -p "$RUNTIME_DIR" "$LOGS_DIR"

echo -e "${YELLOW}Launching the resident...${NC}"
echo -e "${BLUE}  log: $LOG_FILE${NC}"

cd "$SCRIPT_DIR"
POSTGRES_PORT=5433 \
POSTGRES_USER=stefan \
POSTGRES_DATABASE=lyric_db \
LYRIC_NO_WATCHDOG=1 \
TQDM_DISABLE=1 \
LYRIC_TEACHING=1 \
LYRIC_MICROPHONE=off \
LYRIC_CAMERA=off \
nohup ./venv_lyric/bin/python3 -m core.main >> "$LOG_FILE" 2>&1 &
PID=$!
echo "$PID" > "$MAIN_PID_FILE"
echo -e "${GREEN}✓ Started (PID: $PID)${NC}"
echo ""

# Wait for the line the coordinator writes once reading is warm. A grammar edit, or any
# word record written, makes the first read learn from every taught sentence again, which
# is minutes, so this waits rather than calling a slow boot a failed one.
echo -e "${YELLOW}Waiting for reading to come up...${NC}"
for i in $(seq 1 180); do
    if ! ps -p "$PID" > /dev/null 2>&1; then
        echo -e "${RED}❌ The resident exited during start${NC}"
        echo -e "${YELLOW}   Last lines of $LOG_FILE:${NC}"
        tail -20 "$LOG_FILE"
        rm -f "$MAIN_PID_FILE"
        exit 1
    fi
    if grep -q "Ready to read:" "$LOG_FILE" 2>/dev/null; then
        echo -e "${GREEN}✓ $(grep -h "Ready to read:" "$LOG_FILE" | tail -1 | sed 's/.*INFO - //')${NC}"
        break
    fi
    sleep 5
done

if ! grep -q "Ready to read:" "$LOG_FILE" 2>/dev/null; then
    echo -e "${YELLOW}⚠  Still warming after 15 minutes; it is up on PID $PID${NC}"
    echo -e "${YELLOW}   Watch it with: tail -f $LOG_FILE${NC}"
fi

# A halt the constitution wrote outlives the process that wrote it, and a resident that
# restored one refuses everything it is asked. Say so here rather than let it be found
# in an answer.
if grep -qiE "emergency halt|HALTED" "$LOG_FILE" 2>/dev/null; then
    echo ""
    echo -e "${RED}⚠️  A constitution halt is in force; the resident will refuse requests${NC}"
    grep -hiE "emergency halt|HALTED" "$LOG_FILE" | tail -3
fi

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN} Lyric Running${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
